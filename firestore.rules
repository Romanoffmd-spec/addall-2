rules_version = '2';
// AddAll 2.0, онлайн-версия. Данные видит и меняет только активный участник (members/<uid>).
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function mem() { return get(/databases/$(db)/documents/members/$(request.auth.uid)).data; }
    function isMember() { return signed() && exists(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function active() { return isMember() && mem().active == true; }
    function admin() { return active() && mem().admin == true; }
    function role() { return mem().get('role', ''); }
    // орган здравоохранения, фарма и ИТ-администратор не читают данные пациентов: только регистры, отчёты и заявки
    function noPatients() { return role() in ['authority', 'sponsor', 'itadmin']; }
    function booted() { return exists(/databases/$(db)/documents/meta/boot); }

    // признак, что первый администратор уже создан: виден всем (нужен странице входа)
    match /meta/boot {
      allow read: if true;
      allow create: if signed() && !booted()
        && getAfter(/databases/$(db)/documents/members/$(request.auth.uid)).data.admin == true;
      allow update, delete: if false;
    }

    match /members/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      // первый администратор при первом запуске, дальше участников заводит только администратор
      allow create: if (signed() && request.auth.uid == uid && !booted() && request.resource.data.admin == true)
                    || admin();
      allow update, delete: if admin();
    }

    // журнал аудита: только добавление
    match /s_audit/{id} {
      allow read: if active();
      allow create: if active();
      allow update, delete: if false;
    }

    // пользователи и настройки платформы: меняет администратор; сам пользователь может обновить свою запись
    match /s_users/{id} {
      allow read: if active();
      // свою запись сотрудник обновляет, но роль в ней (отдельное поле role) менять не может
      allow write: if admin() || (active() && mem().userId == id && request.resource.data.get('role', '') == role());
    }
    match /s_settings/{id} {
      allow read: if active();
      allow write: if admin();
    }

    // все остальные хранилища (регистры, пациенты, события и т. д.)
    match /{store}/{id} {
      allow read: if active() && store.matches('s_.*') && !(store in ['s_audit', 's_users', 's_settings'])
        && (!noPatients() || store in ['s_registries', 's_releases', 's_datarequests', 's_doctpl', 's_periodApprovals']);
      allow write: if active() && store.matches('s_.*') && !(store in ['s_audit', 's_users', 's_settings'])
        && (!noPatients() || store == 's_datarequests');
    }
  }
}
